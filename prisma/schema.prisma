generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  tagline    String
  price      Int
  compareAt  Int?
  category   String
  condition  String
  era        String
  year       Int
  fitNote    String?
  image      String?
  images     String[]  @default([])
  story      String
  tags       String[]
  sizes      String[]
  featured   Boolean  @default(false)
  inventory  Int?
  visible    Boolean  @default(true)
  artBase    String
  artPattern String
  artAccent  String?
  artAccent2 String?
  artGraphic String?
  artRib     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([visible, featured])
  @@index([category])
  @@index([year])
}

model Order {
  id        String      @id
  placedAt  DateTime    @default(now())
  email     String
  name      String
  subtotal  Int
  shipping  Int
  total     Int
  street    String
  city      String
  postal    String
  country   String
  createdAt DateTime    @default(now())
  items     OrderItem[]

  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String
  slug    String
  name    String
  size    String
  price   Int
  qty     Int

  @@index([orderId])
}
