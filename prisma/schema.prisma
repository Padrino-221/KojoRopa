generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  tagline    String
  price      Int
  compareAt  Int?
  category   String
  condition  String
  image      String?
  images     String[]  @default([])
  story      String
  sizes      String[]
  featured   Boolean  @default(false)
  visible    Boolean  @default(true)
  sold       Boolean  @default(false)
  artBase    String
  artPattern String
  artAccent  String?
  artAccent2 String?
  artGraphic String?
  artRib     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([visible, featured])
  @@index([category])
}

model Order {
  id        String      @id
  placedAt  DateTime    @default(now())
  email     String
  name      String
  phone     String?
  subtotal  Int
  deliveryFee Int
  total     Int
  street    String
  city      String
  postal    String
  country   String
  token     String?
  status    String      @default("pending")
  moolreSessionId     String?
  moolreTransactionId String?
  createdAt DateTime    @default(now())
  items     OrderItem[]

  @@unique([token])
  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String
  slug    String
  name    String
  size    String
  price   Int
  qty     Int

  @@index([orderId])
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model AdminSession {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model AdminLog {
  id        String   @id @default(cuid())
  event     String
  detail    String   @db.Text
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event])
}
