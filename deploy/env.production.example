# Production environment template for KojoRopa.
# Copy the relevant values into /opt/kojoropa/.env on the server
# (the setup script generates secrets and writes that file automatically).

# PostgreSQL connection string
DATABASE_URL="postgresql://kojoropa:PASSWORD@127.0.0.1:5432/kojoropa?schema=public"

# Admin dashboard password
ADMIN_PASSWORD=""

# Optional: TOTP 2FA secret (base32). Leave empty to disable 2FA.
ADMIN_TOTP_SECRET=""

# Secret used to sign the admin session cookie (min 32 random chars)
SESSION_SECRET=""

# Public site URL (SEO, canonical links, sitemap)
NEXT_PUBLIC_SITE_URL="https://store.example.com"

# Currency symbol shown across the store
NEXT_PUBLIC_CURRENCY="GH₵"

# Store name and branding
NEXT_PUBLIC_SITE_NAME="KojoRopa"
NEXT_PUBLIC_SITE_TAGLINE="Secondhand shirts, one of one."
NEXT_PUBLIC_SITE_DESCRIPTION="KojoRopa is a curated secondhand shirt shop from Accra. Graphic tees, deadstock blanks and soft-washed classics — one of one, picked at Kantamanto Market."
NEXT_PUBLIC_SITE_KEYWORDS="thrift store,secondhand,vintage shirts,graphic tees,Kantamanto,Accra,Ghana"

# Contact details shown in the footer
NEXT_PUBLIC_INSTAGRAM_HANDLE="@kojosropa"
NEXT_PUBLIC_FACEBOOK_HANDLE="Kojosropa"
NEXT_PUBLIC_WHATSAPP_NUMBER="0209401655"
NEXT_PUBLIC_TIKTOK_HANDLE="Kojosropa"
NEXT_PUBLIC_SNAPCHAT_HANDLE="Kojosropa"

# Shipping
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=300
NEXT_PUBLIC_SHIPPING_FEE=30
NEXT_PUBLIC_DEFAULT_COUNTRY="Ghana"

# Product limits
NEXT_PUBLIC_MAX_PRODUCT_IMAGES=8
NEXT_PUBLIC_MAX_QTY=99

# Cloudinary (product photos)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Moolre Mobile Money (checkout payments)
MOOLRE_BASE_URL="https://sandbox.moolre.com"
MOOLRE_API_USER=""
MOOLRE_PUB_KEY=""
MOOLRE_ACCOUNT_ID=""
MOOLRE_SECRET=""
