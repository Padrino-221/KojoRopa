# Vercel environment variables.
# Paste these into Vercel Dashboard → Settings → Environment Variables.
# Generate secrets before pasting — see comments below.

# PostgreSQL (use Neon free tier: https://neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/kojoropa?sslmode=require"

# Admin dashboard password
ADMIN_PASSWORD=""

# Optional: TOTP 2FA secret (base32). Leave empty to disable 2FA.
ADMIN_TOTP_SECRET=""

# Session cookie secret (min 32 random chars)
# Generate: openssl rand -base64 32
SESSION_SECRET=""

# Public site URL (your .vercel.app domain or custom domain)
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# Currency (default: GH₵)
NEXT_PUBLIC_CURRENCY="GH₵"

# Store branding
NEXT_PUBLIC_SITE_NAME="KojoRopa"
NEXT_PUBLIC_SITE_TAGLINE="Secondhand shirts, one of one."
NEXT_PUBLIC_SITE_DESCRIPTION="KojoRopa is a curated secondhand shirt shop from Accra. Graphic tees, deadstock blanks and soft-washed classics — one of one, picked at Kantamanto Market."
NEXT_PUBLIC_SITE_KEYWORDS="thrift store,secondhand,vintage shirts,graphic tees,Kantamanto,Accra,Ghana"

# Contact
NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"
NEXT_PUBLIC_INSTAGRAM_HANDLE="@kojoropa"

# Shipping
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=300
NEXT_PUBLIC_SHIPPING_FEE=30
NEXT_PUBLIC_DEFAULT_COUNTRY="Ghana"

# Product limits
NEXT_PUBLIC_MAX_PRODUCT_IMAGES=8
NEXT_PUBLIC_MAX_QTY=99

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Moolre Mobile Money — webhook URL:
# https://your-app.vercel.app/api/webhook/moolre
MOOLRE_BASE_URL="https://sandbox.moolre.com"
MOOLRE_API_USER=""
MOOLRE_PUB_KEY=""
MOOLRE_ACCOUNT_ID=""
MOOLRE_SECRET=""
